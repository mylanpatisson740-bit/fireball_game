#crypter un texte
"""
texte=input("Saisir un texte à crypter :")
text_crypt =""
for lettre in texte :
    code = ord(lettre)
    y=(24*code+61)%95
    z=y+32
    crypt=chr(z)
    text_crypt=text_crypt+crypt

print("Le texte crypté est", text_crypt)
